# ==========================================
# JOB PORTAL - ENVIRONMENT CONFIGURATION
# ==========================================

# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database (Prisma + SQLite) ---
DATABASE_URL="file:./dev.db"

# --- JWT Auth ---
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_long_random_cookie_secret_min_32_chars

# --- Password Hashing ---
BCRYPT_SALT_ROUNDS=12

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_RESUME_SIZE_MB=5
MAX_IMAGE_SIZE_MB=2

# --- Hugging Face Inference API ---
HUGGINGFACE_API_KEY=hf_replace_with_your_free_tier_api_key
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Rate Limiting ---
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# --- Email (future SMTP integration for verify/reset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Job Portal <no-reply@jobportal.dev>"
