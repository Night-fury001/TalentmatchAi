# ==========================================
# JOB PORTAL - FRONTEND ENVIRONMENT CONFIGURATION
# ==========================================
# Optional. Leave unset for local development (Vite's dev proxy handles it,
# see vite.config.js) and for the default single-service production
# deployment (Express serves this build from client/dist — see
# server/server.js). Only set this if the frontend is deployed to a
# different origin than the API (e.g. frontend on Vercel/Netlify, API on
# Render/Railway/a VPS).
#
# Must be a full origin with no trailing slash, e.g.:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
VITE_API_BASE_URL=
